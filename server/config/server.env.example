EDR_API_KEY=replace-with-a-unique-random-key-at-least-32-characters
EDR_JWT_SECRET=replace-with-a-different-random-secret-at-least-32-characters
FLASK_SECRET_KEY=replace-with-another-random-secret-at-least-32-characters
EDR_PORT=5000
EDR_HOST=127.0.0.1
EDR_TLS_ENABLED=false
EDR_DEV_MODE=false
# Production HTTP listener is behind an HTTPS reverse proxy.
# EDR_DATA_DIR=/var/lib/behedr
# EDR_LOG_DIR=/var/log/behedr

# Safe prototype defaults: observation and read-only commands only.
EDR_LAB_MODE=true
EDR_AUTO_RESPONSE=false
EDR_ADVANCED_ML=false
